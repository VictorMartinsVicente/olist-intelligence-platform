POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=olist
POSTGRES_USER=olist_user
POSTGRES_PASSWORD=olist_pass

MLFLOW_TRACKING_URI=http://localhost:5000

# [Framework] CRISP-ML(Q): MLflow ja aceita um tracking server remoto sem
# nenhuma mudanca de codigo -- basta apontar essa URL para um servidor hospedado
# (ex: um servico gratuito de MLflow tracking) para o historico de experimentos
# persistir entre deploys, em vez de ficar so no filesystem efemero do build.
# Exemplo: MLFLOW_TRACKING_URI=https://seu-mlflow-hospedado.exemplo.com