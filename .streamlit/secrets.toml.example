# Copie este arquivo para .streamlit/secrets.toml (NUNCA versione o arquivo real —
# ele já está no .gitignore) para rodar o dashboard localmente usando o mecanismo
# de secrets do Streamlit em vez de variáveis de ambiente.
#
# No Streamlit Community Cloud: cole o mesmo conteúdo em
# App settings -> Secrets, direto no painel web (não precisa de arquivo).

POSTGRES_HOST = "seu-host-postgres-publico.com"
POSTGRES_PORT = "5432"
POSTGRES_DB = "olist"
POSTGRES_USER = "olist_user"
POSTGRES_PASSWORD = "sua-senha-aqui"

# URL da API já deployada (Railway/Render) que serve o modelo de ML
API_URL = "https://olist-delay-prediction-api.up.railway.app"
