# Copie este arquivo para ~/.dbt/profiles.yml (ou defina DBT_PROFILES_DIR=./transformation)
olist_analytics:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('POSTGRES_HOST', 'localhost') }}"
      port: "{{ env_var('POSTGRES_PORT', '5432') | int }}"
      user: "{{ env_var('POSTGRES_USER', 'olist_user') }}"
      pass: "{{ env_var('POSTGRES_PASSWORD', 'olist_pass') }}"
      dbname: "{{ env_var('POSTGRES_DB', 'olist') }}"
      schema: dbt_dev
      threads: 4
